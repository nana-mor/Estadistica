knitr::opts_chunk$set(echo = TRUE)
min = 420
max = 460
resultado = Punif(430,min,max,FALSE)
resultado = punif(430,min,max,TRUE)
print(resultado)
# P(425 < X < 435) = P(X < 435) - P(X <= 425)
resultado = punif(435,min,max,TRUE) - punif(425,min,max,TRUE)
print(resultado)
# P(X > 450) = 1 - P(X < 450)
resultado = 1 - punif(450,min,max,TRUE)
print(resultado)
plot(
x,
dunif(x, min = a, max = b),
type = "l",
xlab = "x",
ylab = "f(x)",
main = "Distribución Uniforme(420, 460)"
)
a <- 420
b <- 460
x <- seq(a, b, length.out = 500)
plot(
x,
dunif(x, min = a, max = b),
type = "l",
xlab = "x",
ylab = "f(x)",
main = "Distribución Uniforme(420, 460)"
)
